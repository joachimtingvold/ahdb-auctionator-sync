package-as: AuctionSync

# CurseForge dependency slugs (not bundled into the addon ZIP).
required-dependencies:
  - auction-house-database
  - auctionator

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .gitattributes
  - .github
  - .gitignore
  - .pkgmeta
  - tests
  - .release
